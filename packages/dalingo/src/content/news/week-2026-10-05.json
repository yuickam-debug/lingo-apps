            {
              "word": "eksporteret",
              "definition": "exported",
              "partOfSpeech": "past part.",
              "grammar": "eksportere (to export) · past participle: eksporteret"
            },
            {
              "word": "nogensinde",
              "definition": "ever",
              "partOfSpeech": "adv.",
              "grammar": "nogensinde = at any time, used in comparisons · mere end nogensinde = more than ever"
            }
          ]
        },
        {
          "id": "da-n03-s02",
          "text": "Medicin og teknologi er de største eksportvarer.",
          "translation": "Medicine and technology are the biggest export goods.",
          "words": [
            {
              "word": "eksportvarer",
              "definition": "export goods",
              "partOfSpeech": "noun, c. pl.",
              "grammar": "en eksportvare · eksport (export) + vare (good/product)"
            }
          ]
        },
        {
          "id": "da-n03-s03",
          "text": "Eksperter forklarer væksten med en stærk global efterspørgsel.",
          "translation": "Experts explain the growth with strong global demand.",
          "words": [
            {
              "word": "væksten",
              "definition": "the growth",
              "partOfSpeech": "noun, c.",
              "grammar": "en vækst · væksten (def.) · from vokse (to grow)"
            },
            {
              "word": "efterspørgsel",
              "definition": "demand",
              "partOfSpeech": "noun, c.",
              "grammar": "en efterspørgsel · efter (after) + spørge (to ask)"
            }
          ]
        },
        {
          "id": "da-n03-s04",
          "text": "Flere danske virksomheder åbner nu kontorer i udlandet.",
          "translation": "More Danish companies are now opening offices abroad.",
          "words": [
            {
              "word": "kontorer",
              "definition": "offices",
              "partOfSpeech": "noun, n. pl.",
              "grammar": "et kontor · kontorer (pl.)"
            }
          ]
        },
        {
          "id": "da-n03-s05",
          "text": "Økonomer forventer, at eksporten fortsætter med at stige næste år.",
          "translation": "Economists expect exports to continue rising next year.",
          "words": [
            {
              "word": "økonomer",
              "definition": "economists",
              "partOfSpeech": "noun, c. pl.",
              "grammar": "en økonom · økonomer (pl.)"
            },
            {
              "word": "fortsætter",
              "definition": "continues",
              "partOfSpeech": "verb",
              "grammar": "fortsætte (to continue) · present: fortsætter"
            }
          ]
        }
      ]
    },
    {
