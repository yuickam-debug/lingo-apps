            {
              "word": "ønsker",
              "definition": "wish, desire",
              "partOfSpeech": "verb",
              "grammar": "ønske (to wish) · present: ønsker"
            },
            {
              "word": "bagefter",
              "definition": "afterwards",
              "partOfSpeech": "adv.",
              "grammar": "bagefter = after that, afterwards"
            }
