            {
              "word": "erhvervsuddannelse",
              "definition": "vocational education",
              "partOfSpeech": "noun, c.",
              "grammar": "en erhvervsuddannelse · erhverv (trade/business) + uddannelse (education)"
            },
            {
              "word": "frem for",
              "definition": "rather than, instead of",
              "partOfSpeech": "prep.",
              "grammar": "frem for = in preference to, fixed phrase"
            }
          ]
        },
        {
          "id": "da-n04-s02",
          "text": "Antallet af elever på erhvervsskoler er steget med 15 procent.",
          "translation": "The number of students at vocational schools has increased by 15 percent.",
          "words": [
            {
              "word": "antallet",
              "definition": "the number",
