            {
              "word": "valget",
              "definition": "the election",
              "partOfSpeech": "noun, n.",
              "grammar": "et valg · valget (def.)"
            }
          ]
        },
        {
          "id": "da-n01-s04",
          "text": "Hun vil arbejde for bedre skoler og mere grøn transport.",
          "translation": "She wants to work for better schools and more green transport.",
          "words": [
            {
              "word": "transport",
              "definition": "transport",
              "partOfSpeech": "noun, c.",
              "grammar": "en transport · transporten (def.)"
            }
          ]
        },
        {
          "id": "da-n01-s05",
          "text": "Den nye borgmester starter i sit embede i august.",
