    {
      "id": "da-news-2026w26-04",
      "title": "Flere unge vælger erhvervsuddannelser",
      "level": "B1",
      "genre": "news",
      "source": "news",
      "metadata": {
        "publishedDate": "2026-06-25",
        "topic": "Uddannelse"
      },
      "sentences": [
        {
          "id": "da-n04-s01",
          "text": "En ny rapport viser, at flere unge vælger en erhvervsuddannelse frem for gymnasiet.",
          "translation": "A new report shows that more young people are choosing a vocational education over the gymnasium (upper secondary school).",
