      "sentences": [
        {
          "id": "da-n01-s01",
          "text": "Aarhus har fået en ny borgmester.",
          "translation": "Aarhus has gotten a new mayor.",
          "words": [
            {
              "word": "borgmester",
              "definition": "mayor",
              "partOfSpeech": "noun, c.",
              "grammar": "en borgmester · borgmesteren (def.) · borgmestre (pl.)"
            }
          ]
        },
        {
          "id": "da-n01-s02",
          "text": "Hun er den første kvindelige borgmester i byen.",
          "translation": "She is the first female mayor in the city.",
          "words": [
            {
              "word": "kvindelige",
              "definition": "female",
              "partOfSpeech": "adj.",
              "grammar": "kvindelig (common/neuter) · kvindelige (pl./def.)"
            }
          ]
        },
        {
          "id": "da-n01-s03",
          "text": "Mange borgere er glade for valget.",
